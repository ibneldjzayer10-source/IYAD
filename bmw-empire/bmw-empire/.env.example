# انسخ هذا الملف باسم .env في نفس المجلد ثم عبّئ القيم.
# ملف .env مُستثنى من Git عبر .gitignore — لا ترفعه أبداً.
# (على GitHub يُضبط ZERNIO_KEY في: Settings > Secrets and variables > Actions)

# ===== النشر =====
# مفتاح Zernio/Late API — إلزامي للنشر الفعلي
LATE_API_KEY=
# عنوان API (الافتراضي مناسب؛ غيّره فقط عند تغيير المزود)
LATE_BASE_URL=https://zernio.com
# أقصى عدد منشورات في التشغيلة (افتراضي 3)
MAX_POSTS_PER_RUN=3
# وضع التجربة: 1 = يبني الكل ولا ينشر شيئاً
DRY_RUN=0

# ===== المحتوى واللغة =====
# لغة النصوص: ar | en
REEL_LANG=ar
# أصوات edge-tts
VOICE_AR=ar-SA-HamedNeural
VOICE_EN=en-US-GuyNeural
# خط الترجمة (ضع خطاً عربياً مثل Cairo في assets/fonts/ واضبطه هنا)
CAPTION_FONT=Arial
# معرّف الحساب المستخدم في الشعار النصي
ACCOUNT_HANDLE=@BMW_M_FANS

# ===== الأدوات =====
# نموذج faster-whisper للتفريغ: tiny | base | small | medium
WHISPER_MODEL=small
